<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Plays player-run blackjack with /random 10, or /dice 10 in a party, alliance, free company or linkshell channel. You press Deal, Hit, Stand, Double or Split; it rolls the cards, reads the results from chat, draws the dealer to 17 and settles the round in units. Nothing rolls without a button press, and never more than once every 2 seconds.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Blackjack14.Tests/**" />
  </ItemGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>Blackjack14</Name>
    <Punchline>Player-run blackjack on /random or /dice: you pick the moves, it rolls, plays the dealer and scores.</Punchline>
    <RepoUrl>https://github.com/priestkos/Blackjack14</RepoUrl>
    <Tags>blackjack;minigame;random;utility</Tags>
    <IconUrl>https://raw.githubusercontent.com/priestkos/Blackjack14/main/images/icon.png</IconUrl>
  </PropertyGroup>
</Project>
