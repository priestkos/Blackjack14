<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Plays player-run blackjack with /random 10: deals, hits, doubles and splits for you, draws the dealer to 17 and settles the round. One /random every 2 seconds at most, only after you press a button.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Blackjack14.Tests/**" />
  </ItemGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>Blackjack14</Name>
    <Punchline>Blackjack with /random 10, dealt and scored for you.</Punchline>
    <RepoUrl>https://github.com/priestkos/Blackjack14</RepoUrl>
    <Tags>blackjack;minigame;random;utility</Tags>
  </PropertyGroup>
</Project>
